# Add your API keys here (or configure via Settings in the app)
# GOOGLE_API_KEY=
# GOOGLE_SEARCH_CX=

# Gemini — used for AI image generation in slides
# GEMINI_API_KEY=

# Anthropic — used by the AI-enrichment spike on /extract (Claude Opus 4.7)
# ANTHROPIC_API_KEY=

# Brandfetch — used for brand logo and color lookups
# BRANDFETCH_API_KEY=
# BRANDFETCH_CLIENT_ID=

# Logo.dev — alternative logo provider
# LOGO_DEV_TOKEN=
# LOGO_DEV_SECRET_KEY=

# Database — defaults to local SQLite (file:./data/app.db)
# Set to a remote URL for cloud database (e.g. libsql://your-db.turso.io)
# DATABASE_URL=
# DATABASE_AUTH_TOKEN=

# Phase 2 hackathon demo — feature-flag seam
# Default is mocked Builder.io SSO + localStorage quota (3 free enrichments).
# Set to 1 post-hackathon when wiring real Builder.io OAuth.
# VITE_FREE_DESIGN_MD_REAL_AUTH=1
#
# URL of a pre-built Builder Space loaded with a sample design.md.
# Drives the "Open in Builder Space" button. If unset the button is hidden.
# VITE_BUILDER_SPACE_URL=https://builder.io/space/your-demo-space
#
# Set to 1 to disable the demo-brand cache short-circuit (stripe/linear/notion
# served from the cache without an LLM call). Useful for testing the live path.
# FREE_DESIGN_MD_DISABLE_DEMO_CACHE=1

# --- Builder.io SSO (real-auth seam) ---
# Set VITE_FREE_DESIGN_MD_REAL_AUTH=1 to flip the client seam from the
# localStorage mock to the real /api/auth/* flow.
# VITE_FREE_DESIGN_MD_REAL_AUTH=1

# The public origin Builder.io should redirect back to. Must match a
# hostname in CLIAuthPage.tsx's isAllowedRedirectUrl (currently:
# localhost, *.agent-native.com, *.builder.io). Required in production.
# PUBLIC_ORIGIN=https://free-design-md.up.railway.app

# The client_id sent to https://builder.io/cli-auth. Shows up in
# Builder's UI as the app requesting authorization.
BUILDER_CLIENT_ID=free-design-md
