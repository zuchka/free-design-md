# Server-only Postgres connection. Local Supabase uses the default below when
# DATABASE_URL is omitted. Railway should use the Supabase direct connection or
# session pooler (port 5432), depending on network support.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# DATABASE_POOL_SIZE=5
# Set to 1 only during the final SQLite snapshot and Postgres cutover. Read
# requests remain available while POST/PUT/PATCH/DELETE return retryable 503s.
# MIGRATION_WRITE_PAUSED=0

# Claude. Hosted calls spend credits; self-hosted calls are unmetered.
# ANTHROPIC_API_KEY=
# FREE_DESIGN_MD_SELF_HOSTED=1

# Public hosted origin and Better Auth.
# PUBLIC_ORIGIN=https://free-design.example
# BETTER_AUTH_URL=https://free-design.example
# BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Magic-link email. Development logs links when RESEND_API_KEY is unset.
# RESEND_API_KEY=
# AUTH_EMAIL_FROM=Free design.md <noreply@example.com>

# Stripe one-time credit packs.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_1_CREDIT=price_...
# STRIPE_PRICE_10_CREDITS=price_...

# Disable the demo-brand enrichment cache to exercise the live model path.
# FREE_DESIGN_MD_DISABLE_DEMO_CACHE=1

# Optional Discord feedback sink.
# FEEDBACK_DISCORD_WEBHOOK_URL=

# Optional Prometheus endpoint protection.
# PROMETHEUS_METRICS_TOKEN=

# Private growth analytics (off by default; always off in self-hosted mode).
# Apply the analytics migration before enabling. Admin access is separately gated.
# GROWTH_ANALYTICS_ENABLED=0
# GROWTH_ANALYTICS_ADMIN_EMAILS=analytics-admin@example.com
# GROWTH_ANALYTICS_ADMIN_USER_IDS=
# GROWTH_ANALYTICS_INTERNAL_USER_IDS=
# Optional dedicated cookie-signing secret; defaults to BETTER_AUTH_SECRET.
# GROWTH_ANALYTICS_COOKIE_SECRET=
# Require an explicit opt-in on /privacy before collecting product analytics.
# GROWTH_ANALYTICS_REQUIRE_CONSENT=0
# Run pnpm analytics:maintain daily in the deployment scheduler.
