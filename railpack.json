{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "build": {
      "commands": [
        "...",
        { "cmd": "pnpm exec playwright install chromium" }
      ],
      "variables": {
        "PLAYWRIGHT_BROWSERS_PATH": "/app/.playwright-browsers"
      }
    }
  },
  "deploy": {
    "startCommand": "NITRO_HOST=0.0.0.0 PORT=3000 node .output/server/index.mjs",
    "variables": {
      "PLAYWRIGHT_BROWSERS_PATH": "/app/.playwright-browsers"
    }
  }
}
